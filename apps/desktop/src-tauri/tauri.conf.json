{
  "productName": "ProofScan Collector",
  "version": "0.1.0",
  "identifier": "com.proofscan.collector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProofScan Collector",
        "width": 720,
        "height": 600,
        "minWidth": 350,
        "minHeight": 450,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
