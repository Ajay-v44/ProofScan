{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "PROOFSCAN_REQUIRE_HTTPS_ORIGIN": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "PROOFSCAN_REQUIRE_HTTPS_ORIGIN": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
