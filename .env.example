# Set the user, password and database to match your local server.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/proofscan
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
COMPOSE_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/proofscan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=proofscan
REDIS_URL=redis://127.0.0.1:6379/0
WEB_ORIGIN=http://localhost:3000
# Required. Generate both secrets using the setup guide.
AUTH_MODE=local
LOCAL_AUTH_SECRET=
REPORT_KEY_ID=local-1
REPORT_PRIVATE_KEY=
# Public keys for older reports when rotating the active private key.
REPORT_TRUSTED_KEYS={}
ENABLE_SIMULATOR=false
# Configure both for AUTH_MODE=supabase using an asymmetric Supabase signing key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set individual subjects, e.g. ["a UUID"], to enable access to operator tools.
ADMIN_SUBJECTS=[]
EVIDENCE_RETENTION_DAYS=30
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=
KIMI_VISION_MODEL=
# Device advisor and mobile planner. Kimi credentials stay in the API environment.
AGENT_MODEL=kimi-k3
AGENT_TEST_MODEL=kimi-k2.6
AGENT_VECTOR_ENABLED=false
AGENT_EMBEDDING_CACHE=./.agent-cache
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# For a new Compose deployment with pgvector, set PROOFSCAN_POSTGRES_IMAGE=pgvector/pgvector:pg17.
PROOFSCAN_POSTGRES_IMAGE=postgres:17-alpine
PROOFSCAN_INSTALL_AGENT=false
PRICING_COMPARABLES_FILE=
# Set in the Expo process when running on a physical phone.
EXPO_PUBLIC_PROOFSCAN_ORIGIN=
# Public HTTPS policy page. Required for EAS preview and production.
EXPO_PUBLIC_PROOFSCAN_PRIVACY_URL=
# Public HTTPS entry point for authenticated account deletion.
EXPO_PUBLIC_PROOFSCAN_DELETE_ACCOUNT_URL=
# Optional release workspace origin. Set in the Tauri build environment.
PROOFSCAN_WEB_ORIGIN=
